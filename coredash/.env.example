# Server configuration
NODE_ENV=production
LOG_LEVEL=debug
TZ=America/Sao_Paulo
CORE_DASH_URL=http://localhost:3000
DB_DRIVER=sqlite
SQLITE_PATH=/data/database.db
DB_SYNCHRONIZE=true

# Optional integrations. Leave blank and fill them in Settings later.
NEWS_API_KEY=""
SERPAPI_KEY=""
BRAPI_TOKEN=""

# Google Calendar (service account) — optional, all three together
GOOGLE_CALENDAR_IDS=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Google Gmail (OAuth2 — create credentials at console.cloud.google.com) — optional, all three together
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_REFRESH_TOKEN=""

# Database (deployment only — not part of the setup form)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Location. Weather uses Open-Meteo and does not need an API key.
# CITY is optional; blank looks the place up from the coordinates.
# These environment values remain the defaults when no database override is saved.
LATITUDE="-23.550520"
LONGITUDE="-46.633308"
CITY=""

# Spotify (optional) — paste credentials in Settings, or connect via the dashboard.
# Add the current dashboard origin plus /api/spotify/callback in the Spotify Developer Dashboard.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
