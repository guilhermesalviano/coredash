# Server configuration
NODE_ENV=production
LOG_LEVEL=debug
TZ=America/Sao_Paulo
BASE_URL=
CORE_DASH_URL=http://localhost:3000
DB_DRIVER=sqlite
SQLITE_PATH=/data/database.db
DB_SYNCHRONIZE=true

# Services
OLLAMA_URL=http://localhost:11434
AI_MODEL=gemma4:e2b
NEWS_API_KEY=""
BRAPI_TOKEN=""
SERPAPI_KEY=""
GEMINI_API_KEY=""

# Google Calendar (service account)
GOOGLE_CALENDAR_IDS="seus e-mail pessoal ou calendar ids" # separate by ;
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Google Gmail (OAuth2 — create credentials at console.cloud.google.com)
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_REFRESH_TOKEN=""

# DB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# location and personal context for AI
LATITUDE= "xx.xxxxxxx"
LONGITUDE="xx.xxxxxxx"
PERSONAL_CONTEXT="Names for you, your partner, and your pets"

# Spotify (optional) — Connect via dashboard UI or run: npx tsx scripts/get-spotify-token.ts
# Add redirect URI in Spotify Developer Dashboard: {BASE_URL}/api/spotify/callback
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
