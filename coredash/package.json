    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.18.2",
    "next": "16.1.6",
    "node-cron": "^4.2.1",
    "ollama": "^0.6.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
