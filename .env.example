# Server configuration
NODE_ENV=production
LOG_LEVEL=debug
TZ=America/Sao_Paulo
CORE_DASH_URL=http://localhost:3000
SQLITE_PATH=database.db
DB_SYNCHRONIZE=true

# Optional integrations. Leave blank and fill them in Settings later.
NEWS_API_KEY=""
SERPAPI_KEY=""
BRAPI_TOKEN=""

# Google Calendar (service account) — optional, all three together
GOOGLE_CALENDAR_IDS=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Google Gmail (OAuth2 — create credentials at console.cloud.google.com) — optional, all three together
GOOGLE_GMAIL_CLIENT_ID=""
GOOGLE_GMAIL_CLIENT_SECRET=""
GOOGLE_GMAIL_REFRESH_TOKEN=""

# Location. Weather uses Open-Meteo and does not need an API key.
# Leave LATITUDE and LONGITUDE blank to configure them on the first-run setup screen.
LATITUDE=""
LONGITUDE=""
CITY=""
